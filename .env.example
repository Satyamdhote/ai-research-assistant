# Copy this file to .env and fill in your own values. Never commit .env.

# Required. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required. Must end with ":free" (the app refuses to start otherwise).
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional. Enables the search_web tool. Without it the app still works and
# search reports "not configured". Use a free-plan key from https://tavily.com
TAVILY_API_KEY=

# Optional. Port for the HTTP server (default 3000).
# PORT=3000

# Optional. Set to 1 to log extra STRUCTURE for each model call (sizes and counts,
# never text). Credentials, reasoning and user content are never logged.
# DEBUG_LLM=1

# Optional, local learning aid. Set to 1 to print the actual text each agent receives and
# returns. This is the one exception to "no content in logs": never share these logs.
# TRACE_AGENTS=1
